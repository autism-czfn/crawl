DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/autism_crawler
DATABASE_URL_SYNC=postgresql://user:pass@localhost:5432/autism_crawler

# search_discovery_requests now lives in a SEPARATE, isolated database that
# search owns and writes to directly (search_discovery_queue, on search's
# own host) — NOT this service's primary DATABASE_URL above. See crawl.txt
# §4/§10 for the full rationale (blast-radius isolation: search never holds
# write credentials to the primary autism_crawler DB). Role
# search_discovery_consumer has SELECT+UPDATE on exactly that one table,
# nothing else. Leave empty and search_queue_loop() logs an error and
# doesn't start, rather than crashing at import time.
SEARCH_QUEUE_DATABASE_URL=postgresql+asyncpg://search_discovery_consumer:PASSWORD@192.168.86.49:5432/search_discovery_queue

# Reddit (machine-to-machine, no user OAuth)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Academic APIs (optional — increase rate limits)
PUBMED_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
ELSEVIER_API_KEY=
SPRINGER_API_KEY=

# Other APIs
YOUTUBE_API_KEY=
NEWSAPI_KEY=

# Polite pool email (mailto= param for CrossRef, OpenAlex, Unpaywall)
CRAWLER_EMAIL=

# Embeddings — fastembed (local, no API key required)
# Model: nomic-ai/nomic-embed-text-v1.5 (768-dim, hardcoded in src/embedder.py)

# Infrastructure
REDIS_URL=
LOG_LEVEL=INFO

# Health check server — polled by the LAN service-monitor (~/data/code/monitor).
# 0.0.0.0 so it's reachable from another machine on the LAN; requires a
# firewall rule allowing incoming connections on this port (see crawl.txt §6).
CRAWLER_HEALTH_HOST=0.0.0.0
CRAWLER_HEALTH_PORT=8010
